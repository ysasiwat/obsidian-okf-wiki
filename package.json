{
  "name": "obsidian-okf-wiki",
  "version": "0.6.2",
  "private": true,
  "description": "Obsidian plugin that serves an MCP server for agents and stores knowledge as Open Knowledge Format (OKF) v0.2 bundles.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "okf": "dist/okf.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cli": "esbuild src/cli/okf.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/okf.cjs --banner:js=\"#!/usr/bin/env node\"",
    "okf": "tsx src/cli/okf.ts",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "install-plugin": "node scripts/install-plugin.mjs",
    "bench": "tsx scripts/bench.ts",
    "lint": "eslint .",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^4.10.2",
    "obsidian": "^1.14.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.4"
  }
}
